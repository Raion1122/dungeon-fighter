# Local Claude Code settings
.claude/

# ChatGPT 1536x1024 raw source PNGs (regenerable, ~91MB)
source_images/

# claude.ai から取得したチャット/Projects の markdown (私的内容。コミットしない)
claude-ai-export/

# 効果音の元素材 (DL/手動投入)。コミットは整形後 assets/sfx/*.mp3 のみ
sfx-pipeline/raw/
sfx-pipeline/sfx-report.md

# Debug preview images generated during sprite extraction
assets/_debug_*.png
assets/_preview_*.png

# Python cache (from sprite extract scripts)
__pycache__/
*.pyc

# 作業用の出力 (tools/paint_blocked_grid.py が出すグリッド焼き込み画像と貼り付け雛形)。
# index.html と assets/room_*.jpg から実行時に再生成できるのでコミットしない。
out/
*.pyo

# VOICEVOX 中間生成物の wav はコミットしない (mp3 のみ配信。assets/voice/*.mp3 と manifest.json はコミット対象)
*.wav

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Editor
.vscode/
.idea/
*.swp
